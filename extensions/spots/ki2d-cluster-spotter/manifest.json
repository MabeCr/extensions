{
  "key": "ki2d-cluster-spotter",
  "name": "KI2D’s DX Cluster Spotter",
  "shortName": "Cluster",
  "version": "0.1.0",
  "api": 10,
  "description": "Posts self-spots, and spots of the stations you work, to the DX cluster network through the node picked in Settings",
  "category": "spots",
  "icon": "access-point-network",
  "keywords": [
    "spots",
    "spotting",
    "self-spot",
    "dx cluster",
    "telnet"
  ],
  "hooks": [
    "spots"
  ],
  "requiresClusterSpot": true,
  "sharedDependencies": {
    "@ham2k/lib-callsigns": "^1.0.0",
    "@ham2k/lib-country-files": "^1.0.0",
    "@ham2k/lib-dxcc-data": "^1.0.0",
    "@ham2k/lib-format-tools": "^1.0.0",
    "@ham2k/lib-geo-tools": "^1.0.0",
    "@ham2k/lib-operation-data": "^1.0.0",
    "i18next": "^23.0.0",
    "liquidjs": "^10.0.0"
  },
  "translations": {
    "es": {
      "name": "Spots al DX Cluster de KI2D",
      "description": "Publica tus auto-spots, y spots de las estaciones que trabajas, en la red de DX Cluster a través del nodo elegido en Ajustes",
      "keywords": [
        "spots",
        "spotting",
        "auto-spot",
        "dx cluster",
        "telnet"
      ]
    }
  }
}

{
  "key": "ham2k-cluster-spots",
  "name": "Cluster Spots",
  "shortName": "Cluster",
  "version": "0.3.1",
  "api": 10,
  "description": "Brings the DX cluster's spots into the Spots panel, and posts self-spots and spots of the stations you work, through the node picked in Settings",
  "category": "spots",
  "icon": "access-point",
  "keywords": [
    "spots",
    "spotting",
    "self-spot",
    "dx cluster",
    "dxspider",
    "ar-cluster",
    "cc cluster",
    "telnet"
  ],
  "hooks": [
    "cluster",
    "spots"
  ],
  "requiresClusterCommand": true,
  "sharedDependencies": {
    "@ham2k/lib-callsigns": "^1.0.0",
    "@ham2k/lib-country-files": "^1.0.0",
    "@ham2k/lib-dxcc-data": "^1.0.0",
    "@ham2k/lib-format-tools": "^1.0.0",
    "@ham2k/lib-geo-tools": "^1.0.0",
    "@ham2k/lib-operation-data": "^1.0.0",
    "i18next": "^23.0.0",
    "liquidjs": "^10.0.0"
  },
  "translations": {
    "es": {
      "name": "Spots del Cluster",
      "description": "Trae los spots del DX cluster al panel de Spots, y publica tus auto-spots y spots de las estaciones que trabajas, a través del nodo elegido en Ajustes",
      "keywords": [
        "spots",
        "spotting",
        "auto-spot",
        "dx cluster",
        "dxspider",
        "ar-cluster",
        "cc cluster",
        "telnet"
      ]
    }
  }
}

{
  "key": "ham2k-call-history",
  "name": "Call History",
  "version": "0.2.1",
  "api": 1,
  "description": "Uses the most recent past QSO with a station, from your log, as a lookup source",
  "category": "lookup",
  "keywords": [
    "callsign",
    "lookup",
    "history"
  ],
  "hooks": [
    "lookup"
  ],
  "sharedDependencies": {
    "@ham2k/lib-callsigns": "^1.0.0",
    "@ham2k/lib-country-files": "^1.0.0",
    "@ham2k/lib-dxcc-data": "^1.0.0",
    "@ham2k/lib-format-tools": "^1.0.0",
    "@ham2k/lib-geo-tools": "^1.0.0",
    "@ham2k/lib-operation-data": "^1.0.0",
    "i18next": "^23.0.0",
    "liquidjs": "^10.0.0"
  },
  "translations": {
    "es": {
      "name": "Historial de contactos",
      "description": "Usa el QSO más reciente con una estación, de tu propio log, como fuente de búsqueda",
      "keywords": [
        "indicativo",
        "búsqueda",
        "historial"
      ]
    }
  }
}
